{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(scripts/careeros *)",
      "Bash(scripts/run_command_gate.sh *)",
      "Bash(scripts/generate-resume-docx.sh *)",
      "Bash(scripts/generate-cover-letter-docx.sh *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)"
    ],
    "ask": [
      "Bash(scripts/careeros close*)",
      "Bash(git commit*)",
      "Bash(git push*)",
      "Edit(/Career/02_Work_Experience/**)",
      "Edit(/Career/03_Skills_and_Portfolio/**)",
      "Edit(/Career/04_Career_Goals_and_Strategy/**)",
      "Edit(/Career/05_Personal_Profile/**)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo \"Current date (from system): $(\"$CLAUDE_PROJECT_DIR\"/scripts/careeros today). Use scripts/careeros today for any date you write.\""
          }
        ]
      }
    ]
  }
}
